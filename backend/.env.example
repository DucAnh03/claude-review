# Backend env — append these to the project-root .env file
# (the same .env used by slack_bot.py / crypto.py)

# Random hex string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
